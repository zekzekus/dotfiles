#!/usr/bin/env bash
# Pin nix/modules/packages/amp-acp.nix to the latest amp-acp release.
# Replaces both the version line and Linux x86_64 archive SRI hash in place.
# Run via `make update-amp-acp`.

set -euo pipefail

nix_file="$(cd "$(dirname "$0")/.." && pwd)/nix/modules/packages/amp-acp.nix"
# shellcheck source=scripts/update-common.sh
source "$(dirname "$0")/update-common.sh"

tag=$(github_tag https://api.github.com/repos/tao12345666333/amp-acp/releases/latest)
version=${tag#v}
[[ "$version" =~ ^[0-9][a-zA-Z0-9.+-]*$ ]] || fail "invalid amp-acp tag: $tag"
echo "amp-acp version: $version"

url="https://github.com/tao12345666333/amp-acp/releases/download/${tag}/amp-acp-linux-x86_64.tar.gz"
echo "  fetching $url"

sri=$(download_hash "$url")
[[ "$sri" =~ ^sha256-[a-zA-Z0-9+/]{43}=$ ]] || fail "invalid archive hash: $sri"
echo "  hash: $sri"

if ! awk -v new_ver="$version" -v new_hash="$sri" '
  /version = "/ {
    versions += sub(/"[^"]*"/, "\"" new_ver "\"")
  }
  /hash = "sha256-/ {
    hashes += sub(/"sha256-[^"]*"/, "\"" new_hash "\"")
  }
  { print }
  END { if (versions != 1 || hashes != 1) exit 1 }
' "$nix_file" > "$work/pin"; then
  fail "expected one version and one hash field in $nix_file; pin unchanged"
fi

install_pin
