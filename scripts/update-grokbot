#!/usr/bin/env bash
# Pin the Grok Bot AppImage using the official stable download redirect.
# Run via `make update-grokbot`.

set -euo pipefail

nix_file="$(cd "$(dirname "$0")/.." && pwd)/nix/modules/packages/grokbot.nix"
# shellcheck source=scripts/update-common.sh
source "$(dirname "$0")/update-common.sh"

# Do not follow the redirect: its target carries the version and revision.
url=$(fetch --head --no-location --output /dev/null --write-out '%{redirect_url}' \
  https://api2.cursor.sh/updates/download/stable/linux-x64/grok-bot-6f47c900083d6a0c)
if [[ ! "$url" =~ ^https://downloads\.cursor\.com/grokbot/stable/([0-9a-f]{40})/linux/x64/Grok_Bot_([0-9]+\.[0-9]+\.[0-9]+)\.AppImage$ ]]; then
  echo "update-grokbot: unexpected stable download URL: $url" >&2
  exit 1
fi
revision=${BASH_REMATCH[1]}
version=${BASH_REMATCH[2]}
echo "grokbot version: $version ($revision)"
echo "  fetching $url"

sri=$(download_hash "$url")
[[ "$sri" =~ ^sha256-[a-zA-Z0-9+/]{43}=$ ]] || fail "invalid archive hash: $sri"
echo "  hash: $sri"

if ! awk -v new_ver="$version" -v new_rev="$revision" -v new_hash="$sri" '
  /version = "/ {
    versions += sub(/"[^"]*"/, "\"" new_ver "\"")
  }
  /revision = "/ {
    revisions += sub(/"[^"]*"/, "\"" new_rev "\"")
  }
  /hash = "sha256-/ {
    hashes += sub(/"sha256-[^"]*"/, "\"" new_hash "\"")
  }
  { print }
  END { if (versions != 1 || revisions != 1 || hashes != 1) exit 1 }
' "$nix_file" > "$work/pin"; then
  fail "expected one version, revision and hash field in $nix_file; pin unchanged"
fi

install_pin
