#!/usr/bin/env bash
# Pin nix/modules/packages/helium.nix to the latest helium-linux release.
# Looks up the newest tag on the imputnet/helium-linux repo and replaces both
# the version line and the AppImage SRI hash in place. Run via
# `make update-helium`.

set -euo pipefail

nix_file="$(cd "$(dirname "$0")/.." && pwd)/nix/modules/packages/helium.nix"
# shellcheck source=scripts/update-common.sh
source "$(dirname "$0")/update-common.sh"

version=$(github_tag https://api.github.com/repos/imputnet/helium-linux/releases/latest)
[[ "$version" =~ ^[0-9][a-zA-Z0-9.+-]*$ ]] || fail "invalid helium version: $version"
echo "helium version: $version"

url="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64.AppImage"
echo "  fetching $url"

sri=$(download_hash "$url")
[[ "$sri" =~ ^sha256-[a-zA-Z0-9+/]{43}=$ ]] || fail "invalid archive hash: $sri"
echo "  hash: $sri"

if ! awk -v new_ver="$version" -v new_hash="$sri" '
  /version = "/ {
    versions += sub(/"[^"]*"/, "\"" new_ver "\"")
  }
  /hash = "sha256-/ {
    hashes += sub(/"sha256-[^"]*"/, "\"" new_hash "\"")
  }
  { print }
  END { if (versions != 1 || hashes != 1) exit 1 }
' "$nix_file" > "$work/pin"; then
  fail "expected one version and one hash field in $nix_file; pin unchanged"
fi

install_pin
