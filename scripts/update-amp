#!/usr/bin/env bash
# Pin nix/modules/packages/amp.nix to amp's latest published binary release.
# Fetches cli-version.txt and the four per-platform SHA256s, rewrites the file
# in place. Run via `make update-amp`.

set -euo pipefail

nix_file="$(cd "$(dirname "$0")/.." && pwd)/nix/modules/packages/amp.nix"
# shellcheck source=scripts/update-common.sh
source "$(dirname "$0")/update-common.sh"

version=$(fetch https://static.ampcode.com/cli/cli-version.txt)
[[ "$version" =~ ^[0-9][a-zA-Z0-9.+-]*$ ]] || fail "invalid Amp version: $version"
echo "amp version: $version"

h_linux_x64=$(fetch "https://static.ampcode.com/cli/${version}/linux-x64-amp.sha256")
h_linux_arm64=$(fetch "https://static.ampcode.com/cli/${version}/linux-arm64-amp.sha256")
h_darwin_x64=$(fetch "https://static.ampcode.com/cli/${version}/darwin-x64-amp.sha256")
h_darwin_arm64=$(fetch "https://static.ampcode.com/cli/${version}/darwin-arm64-amp.sha256")
for hash in "$h_linux_x64" "$h_linux_arm64" "$h_darwin_x64" "$h_darwin_arm64"; do
  [[ "$hash" =~ ^[a-f0-9]{64}$ ]] || fail "invalid Amp SHA256: $hash"
done

echo "  linux-x64    $h_linux_x64"
echo "  linux-arm64  $h_linux_arm64"
echo "  darwin-x64   $h_darwin_x64"
echo "  darwin-arm64 $h_darwin_arm64"

# Single awk pass: rewrite the version and rewrite the sha256
# line that follows each `platform = "<key>"` line.
if ! awk \
  -v new_ver="$version" \
  -v lx="$h_linux_x64" \
  -v la="$h_linux_arm64" \
  -v dx="$h_darwin_x64" \
  -v da="$h_darwin_arm64" '
  BEGIN {
    values["linux-x64"] = lx; values["linux-arm64"] = la
    values["darwin-x64"] = dx; values["darwin-arm64"] = da
  }
  /version = "/ {
    versions += sub(/"[^"]*"/, "\"" new_ver "\"")
  }
  /platform = "/ {
    cur = $0
    sub(/^.*platform = "/, "", cur); sub(/".*$/, "", cur)
    platforms[cur]++; count++
  }
  /sha256 = "/ { all_hashes++ }
  cur in values && /sha256 = "/ {
    hashes += sub(/"[a-f0-9]+"/, "\"" values[cur] "\"")
    cur = ""
  }
  { print }
  END {
    for (p in values) if (platforms[p] != 1) exit 1
    if (versions != 1 || hashes != 4 || all_hashes != 4 || count != 4) exit 1
  }
' "$nix_file" > "$work/pin"; then
  fail "expected one version and four unique platform/hash fields in $nix_file; pin unchanged"
fi

install_pin
